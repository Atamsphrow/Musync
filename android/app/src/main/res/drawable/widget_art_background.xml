<?xml version="1.0" encoding="utf-8"?>
<!-- The cover's slot in the widget: rounded corners (clipped on Android 12+),
     and a ground for the instant before a cover is drawn. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF2A2F38" />
    <corners android:radius="8dp" />
</shape>
